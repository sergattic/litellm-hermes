# Copy to .env (never commit it). Generate secrets with: openssl rand -hex 24
LITELLM_PORT=4000
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.103.0
LITELLM_MASTER_KEY=sk-change-me
LITELLM_DB_PASSWORD=change-me

# Search provider keys: one variable per key, referenced from config/litellm.config.yaml as os.environ/NAME.
# Free tiers first: add as many accounts as you have. Leave unused ones empty and delete their tool entries.
TAVILY_API_KEY_1=
TAVILY_API_KEY_2=
EXA_API_KEY=
BRAVE_API_KEY=
